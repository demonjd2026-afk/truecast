# Copy to .env and fill in to enable the Azure AI Foundry narrator.
# Leave blank to run entirely offline (the deterministic narrator is used).

AZURE_AI_FOUNDRY_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o-mini
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# Replay pacing for the stream (match-minutes per real-second multiplier).
CR_SPEED=40
